{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "tasks": {
    "build:android": {
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/android/**",
        "!$TURBO_ROOT$/android/build/**",
        "$TURBO_ROOT$/src/*.ts",
        "$TURBO_ROOT$/src/*.tsx",
        "$TURBO_ROOT$/example/package.json",
        "$TURBO_ROOT$/example/android/**",
        "!$TURBO_ROOT$/example/android/.gradle/**",
        "!$TURBO_ROOT$/example/android/build/**",
        "!$TURBO_ROOT$/example/android/app/build/**",
        "!$TURBO_ROOT$/**/.gradle/**",
        "!$TURBO_ROOT$/**/.cxx/**",
        "!$TURBO_ROOT$/**/local.properties"
      ],
      "outputs": []
    },
    "build:ios": {
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/*.podspec",
        "$TURBO_ROOT$/ios/**",
        "$TURBO_ROOT$/src/*.ts",
        "$TURBO_ROOT$/src/*.tsx",
        "$TURBO_ROOT$/example/package.json",
        "$TURBO_ROOT$/example/ios/**",
        "!$TURBO_ROOT$/example/ios/build/**",
        "!$TURBO_ROOT$/example/ios/Pods/**",
        "!$TURBO_ROOT$/**/.xcode.env.local"
      ],
      "outputs": []
    }
  }
}
