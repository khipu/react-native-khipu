source 'https://github.com/CocoaPods/Specs.git'

# OJO: un comercio usa la forma con require.resolve que documenta el README,
# porque su copia del plugin vive en node_modules. Aca no sirve: en este repo la
# libreria ES la raiz del workspace y no hay node_modules/react-native-khipu que
# resolver. Por eso el example apunta por path relativo.
#
# Consecuencia: el example NO ejercita el snippet que le damos al comercio. Ese
# camino se verifica aparte, desde una app con el plugin instalado de verdad.
require File.join(__dir__, "..", "..", "ios", "khipu_spm_fix.rb")

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'KhipuExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Debe ir DESPUES de react_native_post_install, que es quien corre la
    # reescritura rota de modulemaps que esto corrige.
    khipu_fix_spm_modulemaps(installer)
  end
end
